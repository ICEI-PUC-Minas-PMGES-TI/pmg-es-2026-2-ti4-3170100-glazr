      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    class UserEntity {\n        -UUID id\n        -String email\n        -String displayName\n        -AccountType accountType\n        -boolean active\n        -int failedLoginAttempts\n        -Instant lockedUntil\n        -Instant lastLoginAt\n        -Instant createdAt\n        -Instant updatedAt\n        -long version\n        -Set~AccessProfileEntity~ accessProfiles\n        +createEmployee()\n        +isLocked()\n        +recordFailedLogin()\n        +recordSuccessfulLogin()\n        +update()\n    }\n\n    class AccessProfileEntity {\n        -UUID id\n        -String name\n        -String description\n        -boolean active\n        -boolean systemProfile\n        -Instant createdAt\n        -Instant updatedAt\n        -long version\n        -Set~PermissionEntity~ permissions\n        +create()\n        +replace()\n        +getPermissions()\n    }\n\n    class PermissionEntity {\n        -String key\n        -String module\n        -String description\n    }\n\n    class PasswordCredentialEntity {\n        -UUID userId\n        -String passwordHash\n        -Instant passwordChangedAt\n        -Instant createdAt\n        -Instant updatedAt\n        +create()\n        +changePassword()\n    }\n\n    class ExternalIdentityEntity {\n        -UUID id\n        -UUID userId\n        -String provider\n        -String subject\n        -String emailAtLink\n        -Instant linkedAt\n        -Instant lastLoginAt\n        +linkGoogle()\n        +recordLogin()\n    }\n\n    class EmployeeInvitationEntity {\n        -UUID id\n        -UUID userId\n        -String tokenHash\n        -Instant expiresAt\n        -Instant consumedAt\n        -Instant revokedAt\n        -DeliveryStatus deliveryStatus\n        -String deliveryErrorCode\n        -Instant sentAt\n        -UUID createdByUserId\n        -Instant createdAt\n        +create()\n        +statusAt()\n        +consume()\n        +revoke()\n        +markSent()\n        +markDeliveryFailed()\n    }\n\n    class PasswordResetEntity {\n        -UUID id\n        -UUID userId\n        -String tokenHash\n        -Instant expiresAt\n        -Instant consumedAt\n        -Instant revokedAt\n        -Instant createdAt\n    }\n\n    class KitEntity {\n        -UUID id\n        -String name\n        -String color\n        -BigDecimal price\n        -Instant createdAt\n        -Instant updatedAt\n        -long version\n        -List~KitComponentEntity~ components\n        +create()\n        +replace()\n        +replaceComponents()\n    }\n\n    class KitComponentEntity {\n        -UUID id\n        -String name\n        -int quantity\n        -String notes\n    }\n\n    class GlassEntity {\n        -UUID id\n        -String name\n        -BigDecimal thicknessMm\n        -String finish\n        -String color\n        -BigDecimal pricePerSquareMeter\n        -boolean active\n        -Instant createdAt\n        -Instant updatedAt\n        -long version\n        +create()\n        +update()\n        +updateStatus()\n    }\n\n    class GlassStockSettingEntity {\n        -UUID glassId\n        -BigDecimal minimumAreaM2\n        -Instant createdAt\n        -Instant updatedAt\n        -long version\n        +create()\n        +updateMinimum()\n    }\n\n    class GlassSheetEntity {\n        -UUID id\n        -UUID glassId\n        -BigDecimal originalWidthMm\n        -BigDecimal originalHeightMm\n        -BigDecimal originalAreaM2\n        -BigDecimal remainingAreaM2\n        -SheetStatus status\n        -Instant createdAt\n        -Instant updatedAt\n        -long version\n        +create()\n        +updateRemainingArea()\n        +calculateArea()\n    }\n\n    class StockMovementEntity {\n        -UUID id\n        -UUID glassSheetId\n        -StockMovementType movementType\n        -BigDecimal previousRemainingAreaM2\n        -BigDecimal resultingRemainingAreaM2\n        -BigDecimal pieceWidthMm\n        -BigDecimal pieceHeightMm\n        -BigDecimal pieceAreaM2\n        -BigDecimal lossAreaM2\n        -String notes\n        -UUID performedByUserId\n        -Instant createdAt\n    }\n\n    class AccountType {\n        &lt;&lt;enumeration&gt;&gt;\n        EMPLOYEE\n        CUSTOMER\n    }\n\n    class DeliveryStatus {\n        &lt;&lt;enumeration&gt;&gt;\n        PENDING\n        SENT\n        FAILED\n    }\n\n    class InvitationStatus {\n        &lt;&lt;enumeration&gt;&gt;\n        PENDING\n        CONSUMED\n        REVOKED\n        EXPIRED\n    }\n\n    class SheetStatus {\n        &lt;&lt;enumeration&gt;&gt;\n        AVAILABLE\n        DEPLETED\n    }\n\n    class StockMovementType {\n        &lt;&lt;enumeration&gt;&gt;\n        RECEIPT\n        ADJUSTMENT\n        MANUAL_CUT\n    }\n\n    UserEntity \&quot;0..*\&quot; -- \&quot;0..*\&quot; AccessProfileEntity : possui\n    AccessProfileEntity \&quot;0..*\&quot; -- \&quot;0..*\&quot; PermissionEntity : concede\n\n    UserEntity \&quot;1\&quot; -- \&quot;0..1\&quot; PasswordCredentialEntity : credencial local\n    UserEntity \&quot;1\&quot; -- \&quot;0..*\&quot; ExternalIdentityEntity : identidade externa\n\n    UserEntity \&quot;1\&quot; -- \&quot;0..*\&quot; EmployeeInvitationEntity : recebe convite\n    UserEntity \&quot;1\&quot; -- \&quot;0..*\&quot; EmployeeInvitationEntity : cria convite\n\n    UserEntity \&quot;1\&quot; -- \&quot;0..*\&quot; PasswordResetEntity : solicita reset\n\n    KitEntity \&quot;1\&quot; *-- \&quot;1..*\&quot; KitComponentEntity : composição\n\n    GlassEntity \&quot;1\&quot; -- \&quot;0..1\&quot; GlassStockSettingEntity : config. estoque\n    GlassEntity \&quot;1\&quot; -- \&quot;0..*\&quot; GlassSheetEntity : possui chapas\n    GlassSheetEntity \&quot;1\&quot; -- \&quot;0..*\&quot; StockMovementEntity : possui movimentações\n    UserEntity \&quot;1\&quot; -- \&quot;0..*\&quot; StockMovementEntity : realiza\n\n    UserEntity ..&gt; AccountType\n    EmployeeInvitationEntity ..&gt; DeliveryStatus\n    EmployeeInvitationEntity ..&gt; InvitationStatus\n    GlassSheetEntity ..&gt; SheetStatus\n    StockMovementEntity ..&gt; StockMovementType&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Gkt5M6GXstbJTEC1A7kL-1">
