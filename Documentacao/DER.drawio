        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    USERS {\n        UUID id PK\n        VARCHAR email UK\n        VARCHAR display_name\n        VARCHAR account_type\n        BOOLEAN active\n        INTEGER failed_login_attempts\n        TIMESTAMPTZ locked_until\n        TIMESTAMPTZ last_login_at\n        TIMESTAMPTZ created_at\n        TIMESTAMPTZ updated_at\n        BIGINT version\n    }\n\n    ACCESS_PROFILES {\n        UUID id PK\n        VARCHAR name UK\n        VARCHAR description\n        BOOLEAN active\n        BOOLEAN system_profile\n        TIMESTAMPTZ created_at\n        TIMESTAMPTZ updated_at\n        BIGINT version\n    }\n\n    PERMISSIONS {\n        VARCHAR key PK\n        VARCHAR module\n        VARCHAR description\n    }\n\n    USER_ACCESS_PROFILES {\n        UUID user_id PK, FK\n        UUID access_profile_id PK, FK\n    }\n\n    ACCESS_PROFILE_PERMISSIONS {\n        UUID access_profile_id PK, FK\n        VARCHAR permission_key PK, FK\n    }\n\n    USER_PASSWORD_CREDENTIALS {\n        UUID user_id PK, FK\n        VARCHAR password_hash\n        TIMESTAMPTZ password_changed_at\n        TIMESTAMPTZ created_at\n        TIMESTAMPTZ updated_at\n    }\n\n    USER_EXTERNAL_IDENTITIES {\n        UUID id PK\n        UUID user_id FK\n        VARCHAR provider\n        VARCHAR subject\n        VARCHAR email_at_link\n        TIMESTAMPTZ linked_at\n        TIMESTAMPTZ last_login_at\n    }\n\n    EMPLOYEE_INVITATIONS {\n        UUID id PK\n        UUID user_id FK\n        VARCHAR token_hash UK\n        TIMESTAMPTZ expires_at\n        TIMESTAMPTZ consumed_at\n        TIMESTAMPTZ revoked_at\n        VARCHAR delivery_status\n        VARCHAR delivery_error_code\n        TIMESTAMPTZ sent_at\n        UUID created_by_user_id FK\n        TIMESTAMPTZ created_at\n    }\n\n    PASSWORD_RESET_REQUESTS {\n        UUID id PK\n        UUID user_id FK\n        VARCHAR token_hash UK\n        TIMESTAMPTZ expires_at\n        TIMESTAMPTZ consumed_at\n        TIMESTAMPTZ revoked_at\n        TIMESTAMPTZ created_at\n    }\n\n    KITS {\n        UUID id PK\n        VARCHAR name UK\n        VARCHAR color\n        DECIMAL price\n        TIMESTAMPTZ created_at\n        TIMESTAMPTZ updated_at\n        BIGINT version\n    }\n\n    KIT_COMPONENTS {\n        UUID id PK\n        UUID kit_id FK\n        VARCHAR name\n        INTEGER quantity\n        VARCHAR notes\n    }\n\n    GLASSES {\n        UUID id PK\n        VARCHAR name\n        DECIMAL thickness_mm\n        VARCHAR finish\n        VARCHAR color\n        DECIMAL price_per_square_meter\n        BOOLEAN active\n        TIMESTAMPTZ created_at\n        TIMESTAMPTZ updated_at\n        BIGINT version\n    }\n\n    GLASS_STOCK_SETTINGS {\n        UUID glass_id PK, FK\n        DECIMAL minimum_area_m2\n        TIMESTAMPTZ created_at\n        TIMESTAMPTZ updated_at\n        BIGINT version\n    }\n\n    GLASS_SHEETS {\n        UUID id PK\n        UUID glass_id FK\n        DECIMAL original_width_mm\n        DECIMAL original_height_mm\n        DECIMAL original_area_m2\n        DECIMAL remaining_area_m2\n        VARCHAR status\n        TIMESTAMPTZ created_at\n        TIMESTAMPTZ updated_at\n        BIGINT version\n    }\n\n    STOCK_MOVEMENTS {\n        UUID id PK\n        UUID glass_sheet_id FK\n        VARCHAR movement_type\n        DECIMAL previous_remaining_area_m2\n        DECIMAL resulting_remaining_area_m2\n        DECIMAL piece_width_mm\n        DECIMAL piece_height_mm\n        DECIMAL piece_area_m2\n        DECIMAL loss_area_m2\n        VARCHAR notes\n        UUID performed_by_user_id FK\n        TIMESTAMPTZ created_at\n    }\n\n    USERS ||--o{ USER_ACCESS_PROFILES : \&quot;possui\&quot;\n    ACCESS_PROFILES ||--o{ USER_ACCESS_PROFILES : \&quot;associa\&quot;\n\n    ACCESS_PROFILES ||--o{ ACCESS_PROFILE_PERMISSIONS : \&quot;concede\&quot;\n    PERMISSIONS ||--o{ ACCESS_PROFILE_PERMISSIONS : \&quot;compoe\&quot;\n\n    USERS ||--o| USER_PASSWORD_CREDENTIALS : \&quot;possui\&quot;\n    USERS ||--o{ USER_EXTERNAL_IDENTITIES : \&quot;vincula\&quot;\n\n    USERS ||--o{ EMPLOYEE_INVITATIONS : \&quot;recebe (user_id)\&quot;\n    USERS ||--o{ EMPLOYEE_INVITATIONS : \&quot;cria (created_by_user_id)\&quot;\n\n    USERS ||--o{ PASSWORD_RESET_REQUESTS : \&quot;solicita\&quot;\n\n    KITS ||--|{ KIT_COMPONENTS : \&quot;contem\&quot;\n\n    GLASSES ||--o| GLASS_STOCK_SETTINGS : \&quot;configura\&quot;\n    GLASSES ||--o{ GLASS_SHEETS : \&quot;possui\&quot;\n    GLASS_SHEETS ||--o{ STOCK_MOVEMENTS : \&quot;registra\&quot;\n    USERS ||--o{ STOCK_MOVEMENTS : \&quot;executa\&quot;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="yZ5GtuWG-cj3zKoKFbqR-1">
