GLAZR_BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
GLAZR_BOOTSTRAP_ADMIN_PASSWORD=troque-esta-frase-senha-inicial
GLAZR_BOOTSTRAP_ADMIN_NAME=Administrador Inicial
GLAZR_ALLOWED_ORIGINS=http://localhost:5173
GLAZR_SESSION_TIMEOUT=8h
GLAZR_COOKIE_SECURE=false
GLAZR_HTTP_PORT=8080
GLAZR_PUBLIC_BASE_URL=http://localhost:8080
GLAZR_INVITATION_TTL=48h
